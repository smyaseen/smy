---
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import site from "@/lib/site";

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image for Open Graph and Twitter cards. */
  image?: string;
  type?: "website" | "article";
  canonical?: string;
  jsonLd?: object;
  /** Link to a markdown version of this page, advertised for agents. */
  markdownHref?: string;
}

const { title, description, image = "/main-cover.jpeg", type = "website", canonical, jsonLd, markdownHref } = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b1c1e" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title={`${site.displayTitle} | Notes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.displayTitle} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Runs before paint so the saved theme never flashes. Dark is the default. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : true;
        document.documentElement.classList.toggle("dark", dark);
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#1b1c1e" : "#fbf8f2");
      } catch {}
    </script>
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:rounded focus:bg-paper focus:px-3 focus:py-2">
      Skip to content
    </a>
    <div class="flex min-h-dvh flex-col">
      <Header />
      <main id="content" class="grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
