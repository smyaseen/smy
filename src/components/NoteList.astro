---
import { type PostCard } from "@/lib/posts";

interface Props {
  posts: PostCard[];
  /** Show each entry's excerpt under its title (used on Projects). */
  withExcerpt?: boolean;
}

const { posts, withExcerpt = false } = Astro.props;

const years = new Map<string, PostCard[]>();
for (const post of posts) {
  const year = post.publishedAt.slice(0, 4);
  years.set(year, [...(years.get(year) ?? []), post]);
}

const shortDate = (iso: string) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
---

<!--
  A logbook: entries grouped under their year, one line each. The year sits in
  a left gutter on wide screens and becomes a small heading on phones.
-->
<div class="flex flex-col" data-note-list>
  {[...years.entries()].map(([year, entries]) => (
    <section data-year class="grid gap-x-6 border-t first:border-t-0 sm:grid-cols-[88px_minmax(0,1fr)]">
      <h3 class="pt-5 pb-1 font-serif text-[17px] text-faint tabular-nums sm:pt-[18px]">{year}</h3>
      <ul class="flex flex-col pb-3 sm:pt-2">
        {entries.map((post) => (
          <li data-slug={post.slug} data-tags={post.tags.join("|")} class="border-b border-rule-soft last:border-b-0">
            <a href={post.path} class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <span class="flex flex-col gap-1">
                <span class="font-serif text-[18px] leading-[1.4] text-ink group-hover:text-accent sm:text-[19px]">{post.title}</span>
                {withExcerpt && post.excerpt && <span class="text-[14px] leading-[1.55] text-muted">{post.excerpt}</span>}
              </span>
              <span class="shrink-0 text-[13px] text-muted tabular-nums">
                {shortDate(post.publishedAt)} · {post.readTimeInMinutes} min
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
