---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { postJsonLd } from "@/lib/json-ld";
import { getPostsOfType, isProject, postDescription, postPath, postType, postUrl, type Post } from "@/lib/posts";
import { render } from "astro:content";
import ShareMenu from "./ShareMenu.astro";
import TocRail from "./TocRail.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const type = postType(post);
const indexPath = `/${type}`;
const description = data.seo?.description || data.subtitle;
const url = postUrl(post);
const markdownHref = `${postPath(post)}.md`;
const longDate = data.publishedAt.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const tags = data.tags.map((tag) => tag.name.toLocaleLowerCase());

// Only h2/h3 go in the contents, and only for posts that opted in on Hashnode.
const tocHeadings = data.tableOfContents?.enabled ? headings.filter((heading) => heading.depth === 2 || heading.depth === 3) : [];
const hasToc = tocHeadings.length > 0;

// Neighbours come from the same collection, so a project links on to the next project.
const siblings = await getPostsOfType(type);
const position = siblings.findIndex((candidate) => candidate.id === post.id);
const newer = siblings[position - 1];
const older = siblings[position + 1];
---

<BaseLayout
  title={`${data.seo?.title || data.title} | Syed Muhammad Yaseen`}
  description={postDescription(post)}
  image={data.coverImage?.url}
  type="article"
  canonical={data.canonicalUrl || url}
  jsonLd={postJsonLd(post)}
  markdownHref={markdownHref}
>
  <!--
    One 680px reading column. On screens wide enough to spare the room (1280px+),
    the contents list sits in the right margin; otherwise it folds above the text.
  -->
  <div class="mx-auto w-full max-w-[1240px] xl:grid xl:grid-cols-[minmax(0,1fr)_680px_minmax(0,1fr)] xl:gap-x-8">
    <article class="reading-column fade-in pt-12 sm:pt-16 xl:col-start-2">
      <header class="flex flex-col gap-4 pb-8">
        <a href={indexPath} class="w-fit py-1 text-[14px] text-muted hover:text-ink">
          ← {isProject(post) ? "All projects" : "All notes"}
        </a>
        <p class="text-[13px] text-muted">
          <time datetime={data.publishedAt.toISOString()}>{longDate}</time>
          <span aria-hidden="true"> · </span>
          {data.readTimeInMinutes} min read
          {tags.length > 0 && (
            <>
              <span aria-hidden="true"> · </span>
              {tags.slice(0, 3).map((tag, i) => (
                <>
                  {i > 0 && ", "}
                  <a href={`${indexPath}?tags=${encodeURIComponent(tag)}`} class="hover:text-ink hover:underline hover:underline-offset-2">
                    {tag}
                  </a>
                </>
              ))}
            </>
          )}
        </p>
        <h1 class="font-serif text-[30px] leading-[1.18] font-medium tracking-[-0.015em] text-balance sm:text-[40px] sm:leading-[1.14] sm:tracking-[-0.02em]">
          {data.title}
        </h1>
        {description && <p class="font-serif text-[19px] leading-[1.55] text-ink-soft italic sm:text-[21px]">{description}</p>}
      </header>

      {data.coverImage?.url && (
        // Covers keep their own aspect ratio. Many carry text near the edges, so cropping cuts it off.
        <img
          src={data.coverImage.url}
          alt={data.coverImage.attribution || description || data.title}
          fetchpriority="high"
          class="mb-10 h-auto w-full rounded-[10px] bg-wash"
        />
      )}

      {hasToc && (
        <div class="mb-8 xl:hidden">
          <TocRail headings={tocHeadings} variant="collapsible" />
        </div>
      )}

      <div class="prose">
        <Content />
      </div>

      <footer class="mt-14 flex flex-col gap-8 border-t pt-6">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[14px]">
          <ShareMenu title={data.title} url={url} />
          <a href={markdownHref} class="link py-2">
            Read as markdown
          </a>
          <a href="/rss.xml" class="link py-2">
            Follow via RSS
          </a>
        </div>

        {(newer || older) && (
          <nav aria-label="More notes" class="grid gap-6 sm:grid-cols-2">
            {older ? (
              <a href={postPath(older)} class="group flex flex-col gap-1">
                <span class="label">Older</span>
                <span class="font-serif text-[18px] leading-[1.4] group-hover:text-accent">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postPath(newer)} class="group flex flex-col gap-1 sm:text-right">
                <span class="label">Newer</span>
                <span class="font-serif text-[18px] leading-[1.4] group-hover:text-accent">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </article>

    {hasToc && (
      <aside class="hidden xl:col-start-3 xl:block">
        <div class="sticky top-10 mt-[calc(4rem+180px)] max-w-[220px]">
          <TocRail headings={tocHeadings} variant="rail" />
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
