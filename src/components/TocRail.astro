---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  /** `rail` is the sticky sidebar on wide screens; `collapsible` is the disclosure shown otherwise. */
  variant: "rail" | "collapsible";
}

const { headings, variant } = Astro.props;
const indent = (depth: number) => (depth > 2 ? "pl-4" : "");
---

{variant === "collapsible" ? (
  <details class="group border-y py-1 text-[15px]">
    <summary class="flex items-center justify-between py-3 text-muted hover:text-ink">
      <span>On this page</span>
      <span aria-hidden="true" class="transition-transform group-open:rotate-45">
        +
      </span>
    </summary>
    <ul class="flex flex-col pb-3">
      {headings.map((heading) => (
        <li>
          <a href={`#${heading.slug}`} class:list={["block py-1.5 text-ink-soft hover:text-accent", indent(heading.depth)]}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </details>
) : (
  <nav data-toc-rail aria-label="On this page" class="flex flex-col gap-3 text-[13px]">
    <span class="label text-[11px]">On this page</span>
    <ul class="flex max-h-[calc(100dvh-8rem)] flex-col gap-0.5 overflow-y-auto">
      {headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class:list={["block py-1 leading-snug text-muted hover:text-ink", indent(heading.depth)]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Mark the section currently being read in the sidebar.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-rail] [data-toc-link]");
  const headings = [...links].map((link) => document.getElementById(link.dataset.tocLink!)).filter((el): el is HTMLElement => Boolean(el));

  if (headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible[0]) return;
        for (const link of links) {
          const active = link.dataset.tocLink === visible[0].target.id;
          link.classList.toggle("text-ink", active);
          link.classList.toggle("font-medium", active);
          link.classList.toggle("text-muted", !active);
        }
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
  }
</script>
