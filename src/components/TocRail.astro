---
import type { MarkdownHeading } from "astro";
import Icon from "./Icon.astro";

interface Props {
  headings: MarkdownHeading[];
  /** `rail` is the sticky desktop sidebar; `collapsible` is the disclosure shown below `lg`. */
  variant: "rail" | "collapsible";
}

const { headings, variant } = Astro.props;
---

{variant === "collapsible" ? (
  <details class="group rounded-xl border">
    <summary class="flex cursor-pointer items-center justify-between gap-2 p-4 text-sm font-medium">
      <span class="flex items-center gap-2">
        <Icon name="list" class="h-4 w-4 text-muted-foreground" />
        On this page
      </span>
      <Icon name="chevron-down" class="h-4 w-4 text-muted-foreground transition-transform group-open:rotate-180" />
    </summary>
    <ul class="mx-4 mb-4 flex flex-col gap-0.5 border-l">
      {headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class:list={[
              "block py-[5px] pr-2 text-[13px] leading-snug text-muted-foreground hover:text-foreground",
              heading.depth > 2 ? "pl-[26px]" : "pl-[13px]",
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </details>
) : (
  <nav data-toc-rail class="flex flex-col gap-2.5" aria-label="On this page">
    <span class="text-[11px] font-semibold tracking-[0.07em] text-muted-foreground/70 uppercase">On this page</span>
    <ul class="flex max-h-[calc(100vh-8rem)] flex-col gap-0.5 overflow-y-auto border-l">
      {headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class:list={[
              "block py-[5px] pr-2 text-[13px] leading-snug text-muted-foreground transition-colors hover:text-foreground",
              heading.depth > 2 ? "pl-[26px]" : "pl-[13px]",
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Highlight the section currently in view in the desktop rail.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-rail] [data-toc-link]");
  const headings = [...links].map((link) => document.getElementById(link.dataset.tocLink!)).filter((el): el is HTMLElement => Boolean(el));

  if (headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible[0]) return;
        for (const link of links) {
          const active = link.dataset.tocLink === visible[0].target.id;
          link.classList.toggle("font-medium", active);
          link.classList.toggle("text-foreground", active);
          link.classList.toggle("shadow-[inset_1px_0_0_currentColor]", active);
        }
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    for (const heading of headings) observer.observe(heading);
  }
</script>
