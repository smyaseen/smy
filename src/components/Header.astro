---
import site from "@/lib/site";
import Icon from "./Icon.astro";

const navs = [
  { href: "/blog", label: "Notes" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname.replace(/\.html$/, "");
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="wide-column flex flex-wrap items-center justify-between gap-x-6 gap-y-1 pt-6 sm:pt-8">
  <a href="/" class="font-serif text-[19px] font-semibold tracking-[-0.01em] hover:text-accent sm:text-[20px]">
    {site.author.name}
  </a>
  <nav aria-label="Main" class="-mr-2 flex items-center text-[14px] text-muted">
    {navs.map((nav) => (
      <a
        href={nav.href}
        aria-current={isActive(nav.href) ? "page" : undefined}
        class:list={["px-2 py-3 hover:text-ink sm:px-2.5", isActive(nav.href) && "font-medium text-ink"]}
      >
        {nav.label}
      </a>
    ))}
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="cursor-pointer px-2 py-3 hover:text-ink sm:px-2.5">
      <Icon name="sun" class="hidden h-[17px] w-[17px] dark:block" />
      <Icon name="moon" class="h-[17px] w-[17px] dark:hidden" />
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    root.classList.toggle("dark", dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
