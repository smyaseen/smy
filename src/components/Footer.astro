---
import site from "@/lib/site";

const links = [
  { href: site.links.github, label: "GitHub" },
  { href: site.links.linkedin, label: "LinkedIn" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="wide-column mt-20 pb-10">
  <div class="flex flex-col gap-3 border-t pt-6 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
    <span>
      © {new Date().getFullYear()} {site.author.name}
    </span>
    <nav aria-label="Elsewhere" class="-ml-2 flex flex-wrap sm:ml-0 sm:-mr-2">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="px-2 py-2 hover:text-ink"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
