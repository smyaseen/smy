---
import { formatDate, type PostCard } from "@/lib/posts";

interface Props {
  post: PostCard;
}

const { post } = Astro.props;
---

<li class="border-b last:border-b-0">
  <a
    href={post.path}
    class="flex flex-col gap-1 rounded-lg px-2 py-4 transition-colors hover:bg-secondary/50 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
  >
    <div class="flex min-w-0 flex-col gap-0.5">
      <span class="text-[15px] leading-snug font-medium">{post.title}</span>
      {post.tags.length > 0 && <span class="text-[13px] text-muted-foreground/70">{post.tags.slice(0, 3).join(" · ")}</span>}
    </div>
    <span class="text-[13px] whitespace-nowrap text-muted-foreground">
      {formatDate(new Date(post.publishedAt))} · {post.readTimeInMinutes} min
    </span>
  </a>
</li>
