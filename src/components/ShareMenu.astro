---
import site from "@/lib/site";

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const e = encodeURIComponent;
const shareText = `${title}\r\n{ by ${site.author.name} }`;

const targets = [
  { label: "X", href: `https://twitter.com/intent/tweet?url=${e(`${url}?ref=x-share`)}&text=${e(shareText)}` },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}` },
  { label: "Reddit", href: `https://www.reddit.com/submit?url=${e(url)}&title=${e(title)}` },
  { label: "Hacker News", href: `https://news.ycombinator.com/submitlink?u=${e(url)}&t=${e(title)}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${e(url)}` },
  { label: "WhatsApp", href: `https://api.whatsapp.com/send?text=${e(title)} ${e(url)}` },
];
---

<details data-share class="relative">
  <summary class="link py-2">Share</summary>
  <div class="absolute right-0 bottom-full z-20 mb-2 flex w-48 flex-col rounded-lg border bg-paper p-1.5 text-[14px] shadow-lg sm:right-auto sm:left-0">
    <button type="button" data-copy={url} class="cursor-pointer rounded-md px-3 py-2 text-left hover:bg-wash">
      <span data-copy-label>Copy link</span>
    </button>
    {targets.map((target) => (
      <a href={target.href} target="_blank" rel="noopener noreferrer" class="rounded-md px-3 py-2 hover:bg-wash">
        {target.label}
      </a>
    ))}
  </div>
</details>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-share]")) {
    const button = menu.querySelector<HTMLButtonElement>("[data-copy]")!;
    const label = menu.querySelector<HTMLElement>("[data-copy-label]")!;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        label.textContent = "Copied";
      } catch {
        label.textContent = "Couldn't copy";
      }
      setTimeout(() => (label.textContent = "Copy link"), 1500);
    });

    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
