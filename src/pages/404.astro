---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="SMY - Page not found" description="This page does not exist.">
  <section class="mx-auto max-w-xl py-16 text-center">
    <h1 class="mb-4 text-7xl font-extrabold tracking-tight lg:text-9xl">404</h1>
    <p class="mb-4 text-3xl font-bold tracking-tight md:text-4xl">Looks like you've found the doorway to the great nothing</p>
    <p class="mb-6 text-lg text-muted-foreground">Sorry about that! Please visit the homepage to get where you need to go.</p>
    <a class="underline underline-offset-4" href="/">
      Take me there!
    </a>
  </section>
</BaseLayout>
