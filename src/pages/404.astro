---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Syed Muhammad Yaseen" description="This page does not exist.">
  <section class="column flex flex-col gap-4 pt-20 pb-10 sm:pt-28">
    <p class="label">404</p>
    <h1 class="font-serif text-[34px] leading-[1.15] font-medium tracking-[-0.02em] sm:text-[42px]">
      Looks like you've found the doorway to the great nothing
    </h1>
    <p class="font-serif text-[19px] leading-[1.6] text-ink-soft">Sorry about that! Please visit the homepage to get where you need to go.</p>
    <a class="link w-fit text-[15px]" href="/">
      Take me there!
    </a>
  </section>
</BaseLayout>
