---
import BaseLayout from "@/layouts/BaseLayout.astro";
import site from "@/lib/site";
import { Content as Bio } from "../../content/about.md";

const links = [
  { href: site.links.github, label: "GitHub" },
  { href: site.links.linkedin, label: "LinkedIn" },
  { href: `mailto:${site.email}`, label: "Email" },
];

const description = "The work, background and writing of Syed Muhammad Yaseen, Senior Software Engineer working on AI backends and scalable APIs.";
---

<BaseLayout title="About | Syed Muhammad Yaseen" description={description} image="/profile-pic.jpg">
  <div class="column fade-in pt-14 sm:pt-20">
    <header class="flex flex-col gap-5 pb-10">
      <img src="/profile-pic.jpg" alt="Syed Muhammad Yaseen" width="88" height="88" class="h-[88px] w-[88px] rounded-full bg-wash object-cover" />
      <div class="flex flex-col gap-1">
        <h1 class="font-serif text-[36px] leading-[1.15] font-medium tracking-[-0.02em] sm:text-[42px]">About</h1>
        <p class="text-[15px] text-muted">
          {site.author.name} · {site.author.role} at Securiti AI / Veeam · Karachi
        </p>
      </div>
      <nav aria-label="Elsewhere" class="-ml-1 flex flex-wrap gap-x-4 text-[15px] font-medium">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="px-1 py-2 text-accent hover:underline hover:underline-offset-4"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <div class="prose border-t pt-8">
      <Bio />
    </div>
  </div>
</BaseLayout>
